{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter_envelope.schema.json",
  "title": "ProviderAdapterEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "requested_model", "response_text",
               "served_model", "served_model_status", "error_classification"],
  "properties": {
    "schema_version": { "const": "v1" },
    "provider": { "type": "string" },
    "requested_model": { "type": "string" },
    "response_text": { "type": "string" },
    "served_model": { "type": "string" },
    "served_model_status": { "enum": ["reported", "unknown", "mismatch"] },
    "sampling_parameters": { "type": "object" },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "request_id": { "type": "string" },
    "error_classification": {
      "enum": ["none", "provider_error", "timeout", "credential_error", "budget_exceeded",
               "schema_invalid", "unknown"]
    },
    "error_message": { "type": "string" },
    "retries": { "type": "integer", "minimum": 0 }
  }
}