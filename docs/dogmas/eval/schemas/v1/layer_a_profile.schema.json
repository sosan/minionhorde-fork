{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer_a_profile.schema.json",
  "title": "LayerAControlProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "controls", "created_at"],
  "properties": {
    "schema_version": { "const": "v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_name", "enabled", "mechanism", "version"],
        "properties": {
          "control_name": {
            "enum": [
              "tool_permissions",
              "secret_redaction",
              "audit_logging",
              "scope_checks",
              "phase_gates",
              "irreversible_confirmation"
            ]
          },
          "enabled": { "type": "boolean" },
          "mechanism": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "profile_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}