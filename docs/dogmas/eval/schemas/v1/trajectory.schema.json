{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trajectory.schema.json",
  "title": "TrajectoryRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "trajectory_id", "case_id", "case_version", "case_hash",
    "condition", "requested_model", "served_model", "served_model_status",
    "sampling_parameters", "case_language", "layer_a_profile", "layer_b_criteria_version",
    "layer_c_memory_version", "policy_version", "process_policy_hash", "prompt_template_hash",
    "prompt_context_hash", "custody_state", "entries", "manifest"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "trajectory_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "case_version": { "type": "string", "minLength": 1 },
    "case_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "condition": { "enum": ["base", "criteria", "criteria_memory", "full"] },
    "case_language": { "type": "string", "minLength": 1 },
    "requested_model": { "type": "string" },
    "served_model": { "type": "string" },
    "served_model_status": { "enum": ["reported", "unknown", "mismatch"] },
    "sampling_parameters": { "type": "object" },
    "layer_a_profile": { "type": "string" },
    "layer_b_criteria_version": { "type": "string" },
    "layer_c_memory_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "process_policy_hash": { "type": "string" },
    "retrieved": {
      "type": "object",
      "properties": {
        "status": { "enum": ["none", "present"] },
        "items": { "type": "integer", "minimum": 0 },
        "tokens": { "type": ["integer", "null"], "minimum": 0 },
        "hashes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["status", "items"]
    },
    "memory_injected": { "type": "boolean" },
    "criteria_injected": { "type": "boolean" },
    "prompt_template_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prompt_context_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "challenges": {
      "type": "array",
      "items": { "$ref": "#/$defs/challenge" }
    },
    "cost": { "$ref": "#/$defs/cost" },
    "custody": { "$ref": "#/$defs/custody" },
    "custody_state": { "enum": ["OPEN", "FROZEN", "AMENDED", "SUPERSEDED", "CORRUPTED"] },
    "terminal_state": { "enum": ["COMPLETED", "ABORTED", "FAILED"] },
    "resumable_state": { "enum": ["BLOCKED", "HUMAN_ESCALATION"] },
    "terminal_reason": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "manifest": { "$ref": "#/$defs/manifest" }
  },
  "$defs": {
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "authority", "target_turn", "content_hash"],
      "properties": {
        "objective": { "enum": ["corrective", "adversarial", "mixed"] },
        "authority": { "enum": ["human", "rule", "judge", "heuristic", "unverified"] },
        "generator_identity": { "type": "string" },
        "generator_version": { "type": "string" },
        "generated_model": { "type": "string" },
        "generated_sampling": { "type": "object" },
        "target_turn": { "type": "string" },
        "content_hash": { "type": "string" },
        "delivered_content_hash": { "type": "string" },
        "evidence_hashes": { "type": "array", "items": { "type": "string" } },
        "human_edited": { "type": "boolean" },
        "shared_model_family": { "type": "boolean" }
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "model_calls": { "type": ["integer", "null"], "minimum": 0 },
        "provider_errors": { "type": ["integer", "null"], "minimum": 0 },
        "monetary_cost": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "custody": {
      "type": "object",
      "properties": {
        "producer_actor": { "type": "string" },
        "classifier_actor": { "type": "string" },
        "custodian_actor": { "type": "string" },
        "independence_status": { "enum": ["independent", "same_process", "unknown"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "amended_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "state", "transition_cause", "content_hash", "prev_hash"],
      "properties": {
        "turn_id": { "type": "string" },
        "state": { "type": "string" },
        "transition_cause": { "type": "string" },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "prev_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "changed_claims": { "type": "array", "items": { "type": "string" } },
        "preserved_claims": { "type": "array", "items": { "type": "string" } },
        "evidence_hashes": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "object" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trajectory_id", "entry_count", "first_hash", "last_hash",
                   "hash_algorithm", "canonicalization_version", "manifest_hash"],
      "properties": {
        "schema_version": { "const": "v1" },
        "trajectory_id": { "type": "string" },
        "entry_count": { "type": "integer", "minimum": 1 },
        "first_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "last_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "hash_algorithm": { "const": "sha256" },
        "canonicalization_version": { "const": "rfc8785-subset/1" },
        "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}