{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer_b_profile.schema.json",
  "title": "LayerBCriteriaProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "criteria_version", "core_dogmas_version",
    "security_policy_version", "criteria", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "criteria_version": { "type": "string", "minLength": 1 },
    "core_dogmas_version": { "type": "string", "minLength": 1 },
    "security_policy_version": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "version", "normative"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "normative": { "type": "boolean" },
          "class": { "enum": ["rule", "incident", "hypothesis", "example"] }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "profile_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}