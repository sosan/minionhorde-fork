{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "project-manager",
  "instructions": [".opencode/rules/security-policy.md"],
  "experimental": {
    "todo": true,
    "subagent_depth": 2
  },
  "permissions": [
    {"action": "external_directory", "resource": "*", "effect": "ask"},
    {"action": "read", "resource": "*.env", "effect": "ask"},
    {"action": "read", "resource": "*.env.*", "effect": "ask"},
    {"action": "read", "resource": "*.env.example", "effect": "allow"},
    {"action": "shell", "resource": "sudo *", "effect": "ask"},
    {"action": "shell", "resource": "rm -rf *", "effect": "ask"},
    {"action": "shell", "resource": "git push --force*", "effect": "ask"}
  ],
  "mcp": {
    "servers": {
      "memory": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
        "environment": {
          "MEMORY_FILE_PATH": "{env:HOME}/.local/share/opencode/memory.jsonl"
        }
      }
    }
  },
  "plugins": [
    "./.opencode/plugins/redact",
    "./.opencode/plugins/instructions",
    "./.opencode/plugins/guard-audit"
  ]
}
